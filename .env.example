# NeuraX Smart Cities Urban Traffic Intelligence System Configuration

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Server
PORT=8000
HOST=0.0.0.0
SPA_PORT=3000

# Dataset Paths
DATA_DIR=./data
DATA_TRAIN_FILE=./data/traffic_train.csv
DATA_VAL_FILE=./data/traffic_validation.csv
DATA_NETWORK_FILE=./data/network.csv
DATA_NODES_FILE=./data/nodes.csv
DATA_INCIDENTS_TRAIN_FILE=./data/incidents_train.csv
DATA_INCIDENTS_VAL_FILE=./data/incidents_validation.csv
DATA_CONTEXT_TRAIN_FILE=./data/context_train.csv
DATA_CONTEXT_VAL_FILE=./data/context_validation.csv
DATA_ROADWORKS_TRAIN_FILE=./data/roadworks_train.csv
DATA_ROADWORKS_VAL_FILE=./data/roadworks_validation.csv
DATA_SIGNAL_PLANS_FILE=./data/signal_plans.csv
DATA_TURN_RESTRICTIONS_FILE=./data/turn_restrictions.csv
DATA_OD_DEMAND_FILE=./data/od_demand_profiles.csv
DATA_PLANNING_CANDIDATES_FILE=./data/planning_candidates.csv
DATA_SCENARIO_EXAMPLES_FILE=./data/scenario_examples.csv
DATA_MANIFEST_FILE=./data/DATASET_MANIFEST.json

# Model Forecasting Hyperparameters
FORECAST_HORIZONS=15,30,45,60
TEMPORAL_RESOLUTION_MIN=5
NUM_SEGMENTS=436
NUM_NODES=120
BATCH_SIZE=64
LEARNING_RATE=0.001
MAX_EPOCHS=100
RANDOM_SEED=42

# Incident Detection Thresholds
INCIDENT_BAYES_Z_SCORE_THRESHOLD=2.5
CONGESTION_INDEX_SEVERE_THRESHOLD=0.75
FALSE_ALARM_FILTER_DECAY=0.85

# Decision Advisory / Routing Engine
MAX_DIVERSION_HOPS=8
PENALTY_TURN_VIOLATION=999999
CONGESTION_IMPEDANCE_WEIGHT=1.8

# LLM / Explainability Keys (Optional / Offline Default)
OPENAI_API_KEY=your-api-key-here-optional
GEMINI_API_KEY=your-gemini-key-here-optional
